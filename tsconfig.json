{
	"compilerOptions": {
		"target": "es2019",
		"module": "commonjs",
		"baseUrl": "./",
		"resolveJsonModule": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"types": ["cypress", "node"],
		"outDir": "dist"
	},
	"include": ["src", "cypress", "cypress.config.ts"]
}
